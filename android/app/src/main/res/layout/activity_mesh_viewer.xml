<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mesh_bg">

    <!-- 顶部标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="52dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <TextView
            android:id="@+id/meshTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="3D 人脸建模"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMeshClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_glass"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:contentDescription="关闭" />
    </LinearLayout>

    <!-- 3D 模型视图 -->
    <com.example.face3d.MeshView3D
        android:id="@+id/meshView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="90dp" />

    <!-- 底部提示 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        android:drawableTop="@drawable/ic_scan"
        android:drawableTint="#78BEFF"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:text="触摸屏幕旋转查看 3D 人脸模型"
        android:textColor="#9FB0C8"
        android:textSize="13sp" />
</FrameLayout>
