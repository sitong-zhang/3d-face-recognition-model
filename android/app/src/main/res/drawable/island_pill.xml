<?xml version="1.0" encoding="utf-8"?>
<!-- 灵动岛收起态：纯黑胶囊 + 一颗摄像头点与一颗传感器点 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 胶囊主体 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#030408" />
            <corners android:radius="15dp" />
            <stroke android:width="0.6dp" android:color="#1A1D24" />
        </shape>
    </item>
    <!-- 摄像头（居中偏左） -->
    <item android:gravity="center_vertical" android:left="38dp" android:right="52dp">
        <shape android:shape="oval">
            <size android:width="7dp" android:height="7dp" />
            <solid android:color="#0B1220" />
            <stroke android:width="1.6dp" android:color="#05070D" />
        </shape>
    </item>
    <!-- 传感器小点 -->
    <item android:gravity="center_vertical|right" android:right="18dp">
        <shape android:shape="oval">
            <size android:width="5dp" android:height="5dp" />
            <solid android:color="#101725" />
        </shape>
    </item>
</layer-list>
